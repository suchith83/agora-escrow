# =============================================================================
# .env.example — copy to .env and fill in real values. NEVER commit .env.
# =============================================================================

# --- Circle Developer-Controlled Wallets ---
# Get from https://console.circle.com → Developers → API Keys
CIRCLE_API_KEY=TEST_API_KEY:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 64-hex string — generate once with `python -c "import secrets; print(secrets.token_hex(32))"`
# then register via `python test.py` (writes a recovery file to register/)
CIRCLE_ENTITY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Arc Testnet ---
# Get via `arc-canteen login` (saved to ~/.arc-canteen/env as $RPC)
ARC_RPC_URL=
# USDC on Arc Testnet (canonical address)
USDC_CONTRACT_ADDRESS=0x3600000000000000000000000000000000000000
ARC_BLOCKCHAIN=ARC-TESTNET

# --- Supabase (server-side, service_role key) ---
# Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...your-service-role-secret...
# Optional — only needed if your Supabase project uses legacy HS256 JWTs
# (new projects use asymmetric JWTs and the backend auto-fetches the public key from JWKS)
SUPABASE_JWT_SECRET=

# --- Gemini (free tier at https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=AIzaSy...your-gemini-key...

# --- CORS / frontend ---
# Local dev: http://localhost:3001
# Production: your Vercel URL, e.g. https://agora-escrow.vercel.app
FRONTEND_ORIGIN=http://localhost:3001
