# =============================================================================
# .env.local.example — copy to .env.local and fill in real values.
# All NEXT_PUBLIC_* vars are exposed to the browser — never put secrets here.
# =============================================================================

# --- Supabase (anon public key, NOT service role) ---
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...your-anon-public-key...

# --- Backend API base URL ---
# Local dev: http://localhost:8000
# Production: your Render URL, e.g. https://agora-escrow-backend.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
